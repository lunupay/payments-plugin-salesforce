<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
	<type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="LunuEnabled">
                <display-name xml:lang="x-default">Lunu Enabled</display-name>
                <description xml:lang="x-default">Enables/disables the Lunu integration.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="LunuAppID">
                <display-name xml:lang="x-default">Lunu App ID</display-name>
                <description xml:lang="x-default">Lunu App ID</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="LunuSecretKey">
                <display-name xml:lang="x-default">Lunu Secret Key</display-name>
                <description xml:lang="x-default">Lunu Secret Key</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="LunuSandboxMode">
                <display-name xml:lang="x-default">Lunu Sandbox Mode</display-name>
                <description xml:lang="x-default">Enables the Lunu sandbox environment. When enabled, customers are redirected to https://widget.sandbox.lunupay.com/ instead of https://widget.lunupay.com/, and API calls go to api.sandbox.lunupay.com instead of api.lunupay.com (the host of the http.lunupayment.cred service credential URL is switched automatically; a credential URL pointing at a non-Lunu host is used as-is).</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="LUNU_PAYMENT">
                <display-name xml:lang="x-default">Lunu Payment</display-name>
                <attribute attribute-id="LunuEnabled"/>
                <attribute attribute-id="LunuAppID"/>
                <attribute attribute-id="LunuSecretKey"/>
                <attribute attribute-id="LunuSandboxMode"/>
            </attribute-group>
        </group-definitions>
    </type-extension>

</metadata>